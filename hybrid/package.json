    "capture": "node scripts/capture.mjs",
    "verify": "npm run test && npm run build && npm run capture"
  },
  "dependencies": {
    "three": "0.185.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "@types/three": "0.185.0",
    "playwright-core": "1.62.1",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
